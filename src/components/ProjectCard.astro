---
const { project, variant = 'grid' } = Astro.props;
---

{variant === 'grid' ? (
  <a class="card" href={`/projects/${project.slug}`}>
    <span class="tag">{project.id}</span>
    <h3>{project.title}</h3>
    <p>{project.blurb}</p>
  </a>
) : (
  <a class="card" href={`/projects/${project.slug}`}>
    <span class="tag">{project.id}</span>
    <div class="body">
      <h3>{project.title}</h3>
      <p>{project.blurb}</p>
    </div>
    <span class="year">{project.year}</span>
  </a>
)}
